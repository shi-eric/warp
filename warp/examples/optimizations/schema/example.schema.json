{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "category",
    "status",
    "summary",
    "recognition",
    "applicability",
    "semantics",
    "impact",
    "claims",
    "compatibility",
    "artifacts",
    "benchmark",
    "clean_room"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"$ref": "#/$defs/nonEmptyString"},
    "category": {
      "enum": [
        "host-device-transfer-elimination",
        "synchronization-avoidance",
        "kernel-fusion",
        "launch-amortization",
        "allocation-reuse",
        "autodiff-strategy",
        "data-layout",
        "shared-memory-register-reuse",
        "work-decomposition",
        "device-native-substitution",
        "interoperability",
        "memory-runtime-tradeoff"
      ]
    },
    "status": {"enum": ["unverified", "recommended", "conditional", "rejected"]},
    "summary": {"$ref": "#/$defs/nonEmptyString"},
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signals"],
      "properties": {"signals": {"$ref": "#/$defs/nonEmptyStringArray"}}
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preconditions", "contraindications"],
      "properties": {
        "preconditions": {"$ref": "#/$defs/nonEmptyStringArray"},
        "contraindications": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observable_outputs", "tolerance"],
      "properties": {
        "observable_outputs": {"$ref": "#/$defs/nonEmptyStringArray"},
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relative", "absolute"],
          "properties": {
            "relative": {"type": "number", "minimum": 0},
            "absolute": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cuda", "cpu", "mechanism"],
      "properties": {
        "cuda": {"enum": ["improved", "neutral", "harmful", "unverified"]},
        "cpu": {"enum": ["improved", "neutral", "harmful", "unverified"]},
        "mechanism": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cuda", "cpu"],
      "properties": {
        "cuda": {
          "type": "array",
          "items": {"$ref": "#/$defs/claim"}
        },
        "cpu": {
          "type": "array",
          "items": {"$ref": "#/$defs/claim"}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warp", "devices", "evidence_max_age_days", "limitations"],
      "properties": {
        "warp": {"$ref": "#/$defs/nonEmptyString"},
        "devices": {"$ref": "#/$defs/deviceClassArray"},
        "evidence_max_age_days": {"type": "integer", "minimum": 1},
        "limitations": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_module", "baseline", "candidate", "correctness", "benchmark", "explanation", "evidence"],
      "properties": {
        "python_module": {"$ref": "#/$defs/nonEmptyString"},
        "baseline": {"$ref": "#/$defs/relativePath"},
        "candidate": {"$ref": "#/$defs/relativePath"},
        "correctness": {"$ref": "#/$defs/relativePath"},
        "benchmark": {"$ref": "#/$defs/relativePath"},
        "explanation": {"$ref": "#/$defs/relativePath"},
        "evidence": {"$ref": "#/$defs/relativePath"}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload",
        "estimated_peak_bytes",
        "warmups",
        "pairs",
        "bootstrap_seed",
        "resamples",
        "equivalence_band"
      ],
      "properties": {
        "workload": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
        },
        "estimated_peak_bytes": {"type": "integer", "minimum": 0},
        "warmups": {"type": "integer", "minimum": 3},
        "pairs": {"type": "integer", "minimum": 10},
        "bootstrap_seed": {"type": "integer", "minimum": 0},
        "resamples": {"type": "integer", "minimum": 10000},
        "equivalence_band": {"$ref": "#/$defs/equivalenceBand"}
      }
    },
    "clean_room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic", "derived_from_private_source", "declaration"],
      "properties": {
        "synthetic": {"const": true},
        "derived_from_private_source": {"const": false},
        "declaration": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "deviceClassArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["cpu", "cuda"]}
    },
    "equivalenceBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": {"type": "number", "minimum": 0},
        "high": {"type": "number", "minimum": 0}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "supporting_record_ids", "scope"],
      "properties": {
        "impact": {"enum": ["improved", "neutral", "harmful"]},
        "supporting_record_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workload", "device"],
          "properties": {
            "workload": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
            },
            "device": {"$ref": "#/$defs/deviceScope"}
          }
        }
      }
    },
    "deviceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "name",
        "architecture",
        "total_memory_bytes",
        "cpu_model",
        "logical_cpu_count",
        "affinity_cpu_count"
      ],
      "properties": {
        "class": {"enum": ["cuda", "cpu"]},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "architecture": {
          "anyOf": [
            {"type": "string"},
            {"type": "integer"},
            {"type": "null"}
          ]
        },
        "total_memory_bytes": {"type": "integer", "minimum": 0},
        "cpu_model": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "logical_cpu_count": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "affinity_cpu_count": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    }
  }
}
